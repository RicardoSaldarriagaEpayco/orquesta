{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-receipt.schema.json",
  "title": "EvidenceReceipt",
  "description": "Recibo firmado de una puerta de calidad sobre un commit (FR-046). Vence si cambia el commit o su árbol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "sha", "tree", "check", "command", "tool_version", "result", "at", "key_id", "signature"],
  "properties": {
    "version": { "const": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "check": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail"] },
    "at": { "type": "string", "format": "date-time" },
    "key_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
